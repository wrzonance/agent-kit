# bench/fixtures/tally/.agent/config.env -- frozen benchmark-arm config.
# Part of the frozen fixture set (see bench/README's "Freezing" section):
# any edit here forks fixture_version. Hand-authored, not bootstrap-repo.sh
# generated -- see "Decisions" in the PR/commit description for why.
#
# Parsed line-wise by agentkit/skills/.shared/scripts/repo-config.sh, never
# sourced. Every key below is in that script's ACCEPTED_KEYS (or matches
# AGENT_CMD_<NAME>) at BOTH benchmark-arm SHAs -- 06d18cf and 53e7e8c --
# confirmed by diffing each SHA's ACCEPTED_KEYS array; see bench/README.
# Kept deliberately small: only the keys a Tier-1 dispatch run against this
# fixture actually needs, so there is nothing here that could resolve
# differently between the two arms.

AGENT_REPO_SLUG=wrzonance/agent-kit-tally-fixture
AGENT_BASE_BRANCH=main
AGENT_WORKTREE_ROOT=.worktrees
AGENT_BRANCH_PREFIXES=feat,fix,refactor,docs,chore,test,perf,ci
AGENT_LABEL_TYPES=bug,enhancement
AGENT_LABEL_AREAS=render,store
AGENT_LABEL_PRIORITIES=p1,p2
AGENT_CMD_TEST=test/smoke.mjs
