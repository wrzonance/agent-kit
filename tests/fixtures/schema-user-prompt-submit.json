  "title": "user-prompt-submit.command.output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "continue": {"type": "boolean"},
    "stopReason": {"type": "string"},
    "systemMessage": {"type": "string"},
    "suppressOutput": {"type": "boolean"},
    "decision": {"enum": ["block"]},
    "reason": {"type": "string"},
    "hookSpecificOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hookEventName"],
      "properties": {
        "hookEventName": {"const": "UserPromptSubmit", "type": "string"},
        "additionalContext": {"type": "string"}
      }
    }
  }
}
