# .agent/config.env -- committed to this repository for the worktree fleet
# and CI (the trunk-carried layout; see onboard-repo Step 7). bootstrap-repo.sh
# --refresh patches only the generator-owned facts below in place; everything
# else here is a maintainer decision it never touches.

AGENT_REPO_SLUG=example-org/example-repo
AGENT_BASE_BRANCH=main
AGENT_PROJECT_OWNER=example-org
AGENT_PROJECT_NUMBER=99
AGENT_STATUS_VOCAB=Backlog,Ready,In progress,In review,Done
AGENT_WORKTREE_ROOT=.worktrees
AGENT_ONBOARDED_BY=agentkit/0.0.1

# Declared verify commands -- judgement work, never regenerated.
AGENT_CMD_TEST=make test
AGENT_CMD_LINT=make lint

# Automated review provider already chosen.
AGENT_REVIEW_PROVIDERS=coderabbit

# Label taxonomy.
AGENT_LABEL_TYPES=bug,feature
AGENT_LABEL_AREAS=area/skills
AGENT_LABEL_PRIORITIES=p1,p2
