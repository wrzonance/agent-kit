#!/usr/bin/env bash
# ak: the single agentkit v2 entry point. `ak <command> [args]`.
set -euo pipefail
AK_HOME=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
export AK_HOME
# shellcheck source=../lib/common.sh
source "$AK_HOME/lib/common.sh"

usage() {
    cat <<'USAGE'
usage: ak <command> [args]
  root:   onboard [--project N [--owner O]]        collect (--issue N | --pr N | --wave)
          plan [--limit N] [--yolo] [--serialize] [--new] [--issue N]...
          pr-plan --pr N [--pr N]...                merge --pr N
  worker: setup   verify   ship --message M [--body-file F]   review
          ci [--timeout S] [--once]   threads [--resolve ID --note T]   receipt --findings F [--remaining T]
          park --reason T
USAGE
}

cmd=${1:-}
[[ -n $cmd && $cmd != -h && $cmd != --help ]] || { usage; exit 0; }
shift
[[ $cmd =~ ^[a-z][a-z-]*$ && -f $AK_HOME/lib/$cmd.sh ]] || { usage >&2; usage_die "unknown command: $cmd"; }
# `ak plan --help` used to answer "unknown argument"; a root asked exactly that before its first plan.
[[ ${1:-} != --help && ${1:-} != -h ]] || { usage; exit 0; }
# shellcheck source=/dev/null
source "$AK_HOME/lib/$cmd.sh"
cmd_main "$@"
